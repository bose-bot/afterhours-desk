# Copy to .env (or set these in your host's dashboard). Never commit real values.

# --- Required ---
# Vapi private API key: dashboard.vapi.ai -> API Keys
VAPI_API_KEY=
# Public https address of this server (no trailing slash). Vapi sends calls' tool requests here.
PUBLIC_URL=https://your-app.example.com
# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SECRET=
ADMIN_TOKEN=

# --- Setup behaviour ---
# auto = sign-ups go live with no human step. approval = they wait until you approve them.
PROVISION_MODE=auto
# Hard cap on clients, so fake sign-ups can't run up your Vapi bill.
MAX_CLIENTS=25
SIGNUPS_PER_IP_PER_HOUR=3
# Used when a sign-up's mobile number isn't a US number.
DEFAULT_AREA_CODE=
DEFAULT_TIMEZONE=America/New_York

# --- Voice and model (optional) ---
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o
# Leave empty for Vapi's default voice.
VAPI_VOICE_PROVIDER=
VAPI_VOICE_ID=

# --- Email (optional but recommended): welcome emails, call summaries, operator alerts ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AfterHours Desk <hello@your-domain.com>"
# Where new-client and setup-failure alerts go (you).
OPERATOR_EMAIL=

# --- Server ---
PORT=3000
DATABASE_PATH=./data/afterhours.db
BRAND_NAME=AfterHours Desk
# Set to 1 when running behind one proxy (Render, Railway, Fly) so rate limiting sees real IPs.
TRUST_PROXY=1
